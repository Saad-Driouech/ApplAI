# ApplAI MCP server settings — copy to mcp_server/.env (gitignored). Environment variables override it.

# ApplAI FastAPI service (docker compose publishes it on localhost only)
APPLAI_API_URL=http://127.0.0.1:8000
# Must equal APPLAI_API_KEY in config/.env
APPLAI_API_KEY=

# Host path of the job_applications folder (read-only access)
APPLAI_APPLICATIONS_DIR=/absolute/path/to/job_applications

# Optional timeouts (seconds) and confirmation lifetime
# REQUEST_TIMEOUT_SECONDS=30
# GENERATE_TIMEOUT_SECONDS=600
# PHASE_TIMEOUT_SECONDS=3600
# CONFIRMATION_TTL_SECONDS=600
